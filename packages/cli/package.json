{
  "name": "jevable",
  "version": "0.2.2",
  "description": "grep that reads meaning: pass through only the records a Jev judgement lets through",
  "type": "module",
  "bin": {
    "jevable": "dist/cli.js"
  },
  "exports": {
    ".": {
      "jevable-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "guide.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=jevable-source --test test/*.test.ts",
    "prepack": "cp ../../LICENSE . && npm run build"
  },
  "dependencies": {
    "@jevable/core": "0.2.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parall-hq/jevable.git",
    "directory": "packages/cli"
  },
  "homepage": "https://jevable.sh",
  "bugs": "https://github.com/parall-hq/jevable/issues"
}
