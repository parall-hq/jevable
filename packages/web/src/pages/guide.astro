---
import { marked } from "marked";
import Base from "../layouts/Base.astro";
import { guide } from "../lib/guide.ts";

// Headings get ids so sections can be linked; the h1 becomes the page title.
const slug = (s: string) => s.toLowerCase().replace(/<[^>]+>/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const renderer = new marked.Renderer();
renderer.heading = function ({ tokens, depth }) {
  const text = this.parser.parseInline(tokens);
  return `<h${depth} id="${slug(text)}">${depth === 1 ? "Guide" : text}</h${depth}>`;
};
const html = marked.parse(guide, { renderer, async: false });
const sections = [...guide.matchAll(/^## (.+)$/gm)].map((m) => ({ title: m[1], id: slug(m[1]) }));
---

<Base theme="paper" title="jevable guide" description="Everything an agent needs to set up a jevable watch: the steps, how each runtime gets the events back, rules, options and recipes.">
  <div class="wrap page">
    <aside aria-label="Guide sections">
      <ul>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.title.replace("For agents: when to reach for it", "When to use it").replace("Test before relying on a question", "Testing").replace("Rules: more than one question", "Rules")}</a></li>)}
      </ul>
      <a class="raw-guide" href="/guide.md">Plain Markdown ↗</a>
    </aside>
    <article set:html={html} />
  </div>
</Base>

<style>
  .page { display:grid; grid-template-columns:180px minmax(0,1fr); gap:48px; padding-top:64px; }
  aside { position:sticky; top:96px; align-self:start; font-size:15px; max-height:calc(100vh - 120px); overflow:auto; }
  aside ul { list-style:none; padding:0; margin:0 0 28px; display:grid; gap:14px; }
  aside a { color:var(--dim); text-decoration:none; }
  aside a:hover { color:var(--fg); }
  a:focus-visible { outline:2px solid var(--wake); outline-offset:4px; }
  article { min-width:0; max-width:740px; font-size:17px; line-height:1.5; }
  article :global(h1) { font-size:clamp(36px,5vw,48px); font-weight:500; letter-spacing:-.035em; line-height:1.1; margin:0 0 28px; }
  article :global(h2) { font-size:27px; font-weight:500; margin:56px 0 20px; line-height:1.25; scroll-margin-top:90px; }
  article :global(h3) { font-size:20px; font-weight:500; margin:32px 0 16px; scroll-margin-top:90px; }
  article :global(p) { margin:0 0 20px; }
  article :global(strong) { font-weight:500; }
  article :global(pre) { background:var(--raised); border:1px solid var(--line); border-radius:6px; padding:20px; font-size:14px; line-height:1.5; margin:24px 0; }
  article :global(pre code) { background:none; border:0; padding:0; font-size:inherit; }
  article :global(li) { margin:10px 0; }
  article :global(ul), article :global(ol) { padding-left:24px; margin:20px 0; }
  article :global(table) { display:block; max-width:100%; overflow-x:auto; border-collapse:collapse; font-size:15px; }
  article :global(th), article :global(td) { text-align:left; padding:14px 12px; border-bottom:1px solid var(--line); }
  article :global(th) { font-weight:500; }
  @media(max-width:860px) {
    .page { grid-template-columns:1fr; gap:32px; padding-top:32px; }
    aside { position:static; max-height:none; }
    aside ul { display:flex; flex-wrap:wrap; gap:10px 20px; margin-bottom:16px; }
    article { font-size:16px; }
  }
</style>
