---
// /bench: the measured cost of watching, computed from the benchmark's own
// result files (bench/wake/), the same arithmetic as bench/wake/report.ts.
import Base from "../layouts/Base.astro";
import labels from "../../../../bench/fresh/labels.json";
import type { Replayed } from "../../../../bench/wake/tally.ts";
import { caught, fresh, freshRun as freshResults, pct, wakes as w } from "../lib/bench.ts";
import { usd } from "../lib/money.ts";

const labelled = Object.values(labels).flat();
const unsure = labelled.filter((l) => l.label === "unsure").length;
const T = fresh.total;
const J = T.jevable;
const cost = (a: keyof typeof T) => T[a].agent$ + T[a].jev$;

const rows = [
  { name: "Wake on every event", key: "every event", note: "a watcher that reports every line" },
  { name: "Keyword alert", key: "keyword alert", note: "a grep written before seeing the data" },
  { name: "Check every 30 minutes", key: "heartbeat 30 min", note: "OpenClaw's default heartbeat; up to 30 min late" },
  { name: "jevable", key: "jevable", note: "Jev judges each event; the agent wakes for passes" },
] as const;


// Everything jevable got wrong on the fresh events.
const text = (e: Replayed) => {
  try {
    const j = JSON.parse(e.line);
    return String(j.name ?? j.title ?? j.text ?? j.body ?? e.line);
  } catch {
    return e.line;
  }
};
const wrong = freshResults.cases.flatMap((c) =>
  c.events
    .filter((e) => e.slice === "fresh" && e.pass !== e.matters)
    .map((e) => {
      const t = text(e);
      return { case: c.id, text: t.length > 150 ? `${t.slice(0, 148)}…` : t, missed: e.matters, score: e.calls?.at(-1)?.value };
    }),
);
const misses = wrong.filter((x) => x.missed);
const nearMisses = misses.filter((x) => x.score !== undefined && x.score >= 0.45).length;
const notAsked = misses.filter((x) => x.score === undefined).length;
---

<Base title="jevable benchmark" description="The cost of watching: four approaches, the same events." theme="paper">
  <div class="study wrap">
    <article>
      <h1>{pct(1 - cost("jevable") / cost("heartbeat 30 min"))} lower cost.<br />{pct(caught(J.missed, fresh.matter))} recall.</h1>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Comparison of watching methods">
          <table class="comparison">
            <thead><tr><th scope="col">Method</th><th scope="col">Estimated cost</th><th scope="col">Wakes</th><th scope="col">Recall</th></tr></thead>
            <tbody>{rows.map(r => <tr class:list={{us:r.key === "jevable"}}>
              <th scope="row">{r.key === "heartbeat 30 min" ? "Heartbeat (30 min)" : r.name}</th>
              <td><span class="cost-cell"><span class="track" aria-hidden="true"><i style={`width:${cost(r.key) / Math.max(...rows.map(x => cost(x.key))) * 100}%`}></i></span><span>{usd(cost(r.key))}</span></span></td>
              <td>{T[r.key].turns}</td><td>{pct(caught(T[r.key].missed, fresh.matter))}</td>
            </tr>)}</tbody>
          </table>
        </div>
        <details>
          <summary>Method &amp; full results</summary>
          <p>We replayed {fresh.events} events across five streams, treating each stream as one day. Costs use measured Claude Code wakes plus Jev calls. The heartbeat is assumed to catch everything; these are replay estimates.</p>
          <h2>Results by stream</h2>
    <table class="cases">
      <thead>
        <tr><th>case</th><th>events (matter)</th>{rows.map((r) => <th>{r.name}</th>)}</tr>
      </thead>
      <tbody>
        {
          fresh.perCase.map((c) => (
            <tr>
              <td>{c.id}</td>
              <td>
                {c.events.length} ({c.events.filter((e) => e.matters).length})
              </td>
              {rows.map((r) => (
                <td>
                  {c.rows[r.key].turns} / <span class:list={{ bad: c.rows[r.key].missed > 0 }}>{c.rows[r.key].missed}</span> / {c.rows[r.key].needless}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="fine">Per case: agent turns / missed / needless wakes.</p>

        <h2>Misses and unnecessary wakes</h2>
        <p>jevable missed {J.missed} relevant events and triggered {J.needless} unnecessary wakes.</p>
        <p>{nearMisses} misses scored between 0.45 and the 0.7 threshold. {notAsked} were filtered out before reaching Jev.</p>
    <ul class="wrong">
      {
        wrong.map((x) => (
          <li>
            <span class:list={["tag", { miss: x.missed }]}>{x.missed ? "missed" : "needless"}</span>
            <span class="case">{x.case}</span>
            <span class="t">{x.text}</span>
            <span class="s">{x.score === undefined ? "not asked" : x.score.toFixed(2)}</span>
          </li>
        ))
      }
    </ul>

        <h2>Method and limits.</h2>
        <p>Events came from status pages, Hacker News, GitHub issues, releases and PR reviews. A separate agent labelled them without seeing the rules or scores.</p>
        <p>This is a small, model-labelled sample. Quiet streams make scheduled heartbeats expensive. Savings and recall will vary with your workload.</p>

          <p>Single-event wakes averaged {usd(w.single.cost)} across {w.single.n} runs ({usd(w.single.min)}–{usd(w.single.max)}). Batched wakes averaged {usd(w.batch.cost)} across {w.batch.n} runs. Jev input costs $0.042 per million tokens.</p>
    <div class="cols">
      <div>
        <h3>Method</h3>
        <ul>
          <li>Five cases, each a live source and a rule from <code>cases/</code>; events fetched after the rules were last changed, never used to write any rule.</li>
          <li>Labels by a separate agent that saw only each case's goal — not the rules, not any score. Events it was unsure about ({unsure} of {labelled.length}) are left out.</li>
          <li>Keyword regexes were written down before any results were seen.</li>
          <li>Wake cost measured with headless Claude Code ({w.models.join(", ")}): {usd(w.act)} to act on an event, {usd(w.idle)} to decide it does not matter.</li>
          <li>Jev answers are real ({freshResults.jev}).</li>
        </ul>
      </div>
      <div>
        <h3>Limits</h3>
        <ul>
          <li>Measured wakes start a fresh session. Costs in a long-running session may differ as context grows.</li>
          <li>The labeller is a model, not a person; a few calls are arguable (listed above as needless wakes).</li>
          <li>{fresh.matter} events that matter is a small sample; one case (review comments) had only {fresh.perCase.find((c) => c.id === "review-asks")?.events.filter((e) => e.matters).length}.</li>
          <li>The heartbeat looks bad because these streams are small: it pays 48 checks a day however quiet the day is.</li>
          <li>jevable misses events. Near-threshold scores are the next thing to fix: collect them for a periodic look instead of dropping them.</li>
        </ul>
      </div>
    </div>

        <p class="sources"><a href="https://github.com/parall-hq/jevable/tree/main/bench/wake">Code and results ↗</a></p>
        </details>
    </article>
  </div>
</Base>

<style>
  .study { position:relative; max-width:1120px; padding-top:64px; }
  article { max-width:740px; margin:0 auto; font-size:17px; line-height:1.5; font-kerning:normal; }
  h1 { font-size:clamp(36px,5vw,48px); line-height:1.1; font-weight:500; letter-spacing:-.035em; margin:0 0 16px; }
  p { max-width:65ch; margin:0 0 20px; }
  h2 { font-size:27px; font-weight:500; line-height:1.25; margin:32px 0 20px; letter-spacing:-.025em; }
  .table-scroll { overflow-x:auto; margin:28px 0 18px; }
  table { width:100%; border-collapse:collapse; font-variant-numeric:tabular-nums; font-size:15px; }
  th,td { text-align:right; padding:18px 12px; border-bottom:1px solid var(--line); white-space:nowrap; }
  th:first-child, td:first-child { text-align:left; }
  th { font-weight:500; }
  thead { color:var(--dim); font-size:14px; }
  .comparison { min-width:610px; }
  .comparison th:first-child { padding-left:0; }
  .us { background:var(--wake-soft); }
  .us th:first-child { padding-left:12px; }
  .cost-cell { display:flex; align-items:center; gap:16px; justify-content:flex-end; }
  .cost-cell > span:last-child { min-width:58px; }
  .track { width:100px; height:7px; background:var(--line); display:block; }
  .track i { display:block; height:100%; background:var(--faint); }
  .us .track i { background:var(--wake); }
  details { border-top:1px solid var(--line); border-bottom:1px solid var(--line); margin-top:24px; padding:16px 0; }
  summary { cursor:pointer; font-size:16px; }
  summary:hover { color:var(--wake); }
  summary:focus-visible, a:focus-visible { outline:2px solid var(--wake); outline-offset:5px; }
  details[open] summary { margin-bottom:24px; }
  .cases { display:block; overflow-x:auto; font-size:14px; }
  .fine { font-size:15px; color:var(--dim); margin:18px 0 0; }
  .wrong { list-style:none; padding:0; }
  .wrong li { display:grid; grid-template-columns:minmax(0, 1fr) 112px; gap:8px 24px; padding:18px 0; align-items:baseline; border-bottom:1px solid var(--line); }
  .tag { grid-column:1; grid-row:1; font-weight:500; }
  .case { grid-column:2; grid-row:1; text-align:right; }
  .case,.s { color:var(--dim); font-size:15px; }
  .t { grid-column:1; grid-row:2; overflow-wrap:anywhere; }
  .s { grid-column:2; grid-row:2; text-align:right; font-variant-numeric:tabular-nums; }
  li { margin-bottom:10px; }
  .cols h3 { font-size:18px; margin:28px 0 14px; font-weight:500; }
  .cols ul { padding-left:22px; }
  .sources { margin-top:24px; }
  @media(max-width:600px) { .wrong li { grid-template-columns:minmax(0, 1fr) 90px; column-gap:12px; } .study { padding-top:32px; } article { font-size:16px; } h2 { font-size:24px; } }
</style>
