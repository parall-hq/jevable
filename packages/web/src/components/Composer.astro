---
// The one prompt: copy it into any agent and it works. Optionally, a job in front.
import demo from "../data/demo.json";
import { promptHtml } from "../lib/prompt.ts";

interface Props {
  /** Unique per page: the composer appears more than once. */
  id: string;
}

const { id } = Astro.props;
// Status incidents first: a source any agent can reach.
const examples = [
  ...demo.map((c) => ({ label: c.title, ask: c.ask })).sort((a, b) => Number(b.ask.includes("incident")) - Number(a.ask.includes("incident"))),
  { label: "PR review asks", ask: "When a reviewer asks for a change on PR #12 in acme/api, make the change and push it." },
  { label: "Dev log", ask: "While I work, watch logs/dev.log and wake up when a dependency goes down." },
];
---

<div class="composer">
  <div class="card">
    <div class="bar">
      <span>Paste this into your agent</span>
      <button type="button" class="copy">Copy prompt</button>
    </div>
    <pre set:html={promptHtml("")} />
  </div>
  <div class="job">
    <label for={id}>Or give it one job <em>(optional)</em></label>
    <input id={id} type="text" autocomplete="off" spellcheck="false" placeholder="What should it watch, and what should happen when it matters?" />
    <div class="chips" role="list">
      {examples.map((e) => <button type="button" role="listitem" class="chip" data-ask={e.ask}>{e.label}</button>)}
    </div>
  </div>
  <p class="works">
    Works in Claude Code, Codex, OpenClaw, Hermes, pi, dsh — any agent that runs shell commands. It asks you once for an API key from TypeSafe, OpenRouter or
    Vercel, and sets itself up.
  </p>
</div>

<script>
  import { prompt, promptHtml } from "../lib/prompt.ts";

  for (const box of document.querySelectorAll<HTMLElement>(".composer")) {
    const job = box.querySelector("input")!;
    const shown = box.querySelector("pre")!;
    const copy = box.querySelector<HTMLButtonElement>(".copy")!;
    const chips = [...box.querySelectorAll<HTMLButtonElement>(".chip")];
    const sync = () => {
      shown.innerHTML = promptHtml(job.value);
      for (const c of chips) c.classList.toggle("on", c.dataset.ask === job.value.trim());
    };
    job.addEventListener("input", sync);
    for (const c of chips)
      c.addEventListener("click", () => {
        job.value = c.classList.contains("on") ? "" : c.dataset.ask!;
        sync();
      });
    copy.addEventListener("click", async () => {
      await navigator.clipboard.writeText(prompt(job.value));
      copy.textContent = "Copied";
      copy.classList.add("done");
      setTimeout(() => {
        copy.textContent = "Copy prompt";
        copy.classList.remove("done");
      }, 1600);
    });
  }
</script>

<style>
  .composer {
    display: grid;
    gap: 18px;
  }

  .card {
    background: var(--sunken);
    border: 1px solid var(--wake-line);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 0 0 4px var(--wake-soft),
      0 40px 100px -40px rgb(255 181 71 / 0.35);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 10px 10px 20px;
    border-bottom: 1px solid var(--line);
    font: 500 12px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .copy {
    border: 0;
    background: var(--wake);
    color: var(--bg);
    border-radius: 8px;
    padding: 9px 18px;
    font: 600 14px var(--sans);
    cursor: pointer;
    white-space: nowrap;
  }

  .copy:hover {
    filter: brightness(1.08);
  }

  .copy.done {
    background: var(--fg);
  }

  pre {
    padding: 22px 24px 26px;
    font: 17px/1.6 var(--mono);
    color: var(--wake);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    text-align: left;
  }

  pre :global(.need) {
    color: var(--fg);
  }

  pre :global(.nb) {
    white-space: nowrap;
  }

  .job {
    display: grid;
    gap: 10px;
    text-align: left;
  }

  label {
    font-size: 14px;
    color: var(--dim);
  }

  label em {
    font-style: normal;
    color: var(--faint);
  }

  input {
    width: 100%;
    background: var(--raised);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--fg);
    font: 15px var(--sans);
    padding: 11px 14px;
    outline: none;
  }

  input:focus {
    border-color: var(--wake-line);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    border: 1px solid var(--line-strong);
    background: transparent;
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 13px;
    color: var(--dim);
    cursor: pointer;
  }

  .chip:hover {
    color: var(--fg);
  }

  .chip.on {
    border-color: var(--wake-line);
    color: var(--wake);
    background: var(--wake-soft);
  }

  .works {
    margin: 0;
    font-size: 13px;
    color: var(--faint);
    text-align: left;
  }

  @media (max-width: 560px) {
    pre {
      font-size: 15px;
      padding: 18px;
    }

    .bar span {
      font-size: 11px;
    }
  }
</style>
