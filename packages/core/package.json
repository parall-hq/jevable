{
  "name": "@jevable/core",
  "version": "0.2.2",
  "description": "The jevable rule engine: CEL rules that ask Jev, TypeSafe's classification model, semantic questions",
  "type": "module",
  "exports": {
    ".": {
      "jevable-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "jevable-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=jevable-source --test test/*.test.ts",
    "prepack": "cp ../../LICENSE . && npm run build"
  },
  "dependencies": {
    "@bufbuild/cel": "0.6.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parall-hq/jevable.git",
    "directory": "packages/core"
  },
  "homepage": "https://jevable.sh",
  "bugs": "https://github.com/parall-hq/jevable/issues"
}
